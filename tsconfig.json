{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    
    // Vercel-এর যেন বুঝতে সমস্যা না হয়, তাই CommonJS করে দেওয়া হলো
    "module": "CommonJS",
    "moduleResolution": "node",
    
    // Server compatibility এর জন্য এই লাইনটি খুব জরুরি
    "esModuleInterop": true, 
    "allowSyntheticDefaultImports": true,
    
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "eslint.config.mjs"
  ]
}
